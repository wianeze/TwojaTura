NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-local-publishable-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Web Push. Publiczny klucz VAPID trafia do przeglądarki i tylko on może mieć
# prefiks NEXT_PUBLIC_. Parę kluczy generuje `npx web-push generate-vapid-keys`.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Server-only.
SUPABASE_SECRET_KEY=your-local-secret-key
SUPABASE_SERVICE_ROLE_KEY=
BGG_TOKEN=your-server-side-bgg-token

# Web Push, wyłącznie po stronie serwera. Prywatny klucz VAPID nigdy nie może
# trafić do zmiennej NEXT_PUBLIC_* ani do repozytorium. VAPID_SUBJECT to adres
# kontaktowy wymagany przez dostawców, w formacie `mailto:...`.
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Sekret Vercel Cron chroniący GET /api/push/dispatch. Vercel wstrzykuje go
# automatycznie w nagłówek Authorization, gdy zmienna jest ustawiona
# w projekcie. Bez niej endpoint odpowiada 503, nigdy „przepuść”.
CRON_SECRET=

# Optional, server-only override for the Supabase URL used by Server
# Components/Actions and proxy.ts. Only needed when testing over LAN (e.g.
# a phone): set NEXT_PUBLIC_SUPABASE_URL above to this machine's LAN IP
# (http://192.168.x.x:54321) so the *browser* can reach Supabase, then set
# SUPABASE_URL to keep the *server* talking to it over the loopback address
# instead. Leave unset otherwise — it defaults to NEXT_PUBLIC_SUPABASE_URL.
# SUPABASE_URL=http://127.0.0.1:54321
